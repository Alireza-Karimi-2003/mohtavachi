# ---------- Public ----------
APP_ENV=production
DOMAIN=bot.example.com
PUBLIC_BASE_URL=https://bot.example.com
WEBHOOK_SECRET=replace-with-a-long-random-secret

# ---------- Telegram ----------
BOT_USERNAME=mohtavachi_ai_bot
BOT_TOKEN=replace-with-botfather-token
ADMIN_TELEGRAM_ID=0

# ---------- PostgreSQL ----------
POSTGRES_DB=mohtavachi
POSTGRES_USER=mohtavachi
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://mohtavachi:replace-with-a-long-random-password@postgres:5432/mohtavachi

# ---------- AI ----------
# Production uses an external OpenAI-compatible AI API.
AI_PROVIDER=openai_compatible
OLLAMA_BASE_URL=
OLLAMA_MODEL=gemma3:12b
OLLAMA_TIMEOUT=300
AI_API_BASE_URL=https://replace-with-your-ai-provider.example/v1
AI_API_KEY=replace-with-your-ai-api-key
AI_MODEL=gpt-5.6-luna
AI_FALLBACK_MODEL=gpt-5-mini
AI_FALLBACK_REASONING_EFFORT=minimal
AI_IMAGE_MODEL=gpt-image-1-mini
STUDIO_PLUS_AI_MODEL=gpt-5.6-terra
STUDIO_PLUS_IMAGE_MODEL=gpt-image-1-mini

# ---------- Pricing ----------
STARTER_PRICE=299000
PRO_PRICE=599000
STUDIO_PRICE=1190000
STUDIO_PLUS_PRICE=2490000
STUDIO_PLUS_CREDITS=1600

# ---------- Payments ----------
PAYMENT_ENABLED=false
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
PAYMENT_TIMEOUT=20
PAYMENT_ORDER_REUSE_MINUTES=60
